{
  "name": "ai-adoption-pulse-check",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first, open-source employee AI adoption discovery tool. Phase 0: deterministic core engine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run build:client && npm run build:worker",
    "build:client": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir=dist/worker",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "fixture:generate": "tsx scripts/generate-fixture.ts",
    "analysis:report": "tsx scripts/run-analysis.ts",
    "db:migrate:local": "wrangler d1 migrations apply pulse_check --local",
    "db:migrate:remote": "wrangler d1 migrations apply pulse_check --remote",
    "db:seed:local": "wrangler d1 execute pulse_check --local --file=./scripts/dev-seed.sql",
    "dev:setup": "npm run db:migrate:local && npm run db:seed:local"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  }
}
